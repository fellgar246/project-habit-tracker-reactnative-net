# Copy this file to .env and adjust values before running docker compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# JWT (required for auth). Use a secure random string of at least 32 characters.
JWT__Issuer=HabitTracker
JWT__Audience=HabitTracker
JWT__Key=change_me_to_a_secure_key_at_least_32_chars
JWT__AccessTokenMinutes=15
JWT__RefreshTokenDays=7

# Set to true to seed demo user (demo@habittracker.local / Demo1234) on startup
SEED_DEMO_DATA=false
